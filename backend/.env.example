# Banco de dados de produção (não executar migrations contra ele localmente se houver pendentes)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Chaves secretas para os tokens JWT (mínimo de 24 caracteres cada)
JWT_SECRET="seu-segredo-admin-muito-longo-e-seguro-aqui"
JWT_SECRET_CLIENTE="seu-segredo-cliente-muito-longo-e-seguro-aqui"
JWT_SECRET_BARBEIRO="seu-segredo-barbeiro-muito-longo-e-seguro-aqui"
JWT_EXPIRES_IN="7d"

# Porta onde o backend será executado
PORT=3001

# Ambiente de execução (production ou development)
NODE_ENV=development

# URL do frontend (necessário para o CORS)
FRONTEND_URL="http://localhost:5173"

# Nome da barbearia (usado em emails/mensagens de sistema, opcional)
BARBEARIA_NOME="Nome da Barbearia"

# Banco de dados de produção (não executar migrations contra ele localmente se houver pendentes)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Chaves secretas para os tokens JWT (mínimo de 24 caracteres cada)
JWT_SECRET="seu-segredo-admin-muito-longo-e-seguro-aqui"
JWT_SECRET_CLIENTE="seu-segredo-cliente-muito-longo-e-seguro-aqui"
JWT_SECRET_BARBEIRO="seu-segredo-barbeiro-muito-longo-e-seguro-aqui"
JWT_EXPIRES_IN="7d"

# Porta onde o backend será executado
PORT=3001

# Ambiente de execução (production ou development)
NODE_ENV=development

# URL do frontend (necessário para o CORS)
FRONTEND_URL="http://localhost:5173"

# Origens extras permitidas no CORS (separadas por vírgula). Usado para permitir testes mobile na rede local.
CORS_EXTRA_ORIGINS=

# Nome da barbearia (usado em emails/mensagens de sistema, opcional)
BARBEARIA_NOME="Nome da Barbearia"

# Assinaturas — seguro por padrão. Não habilite os dois provedores ao mesmo tempo.
# Simulador determinístico apenas para desenvolvimento/testes locais.
ASSINATURA_PROVEDOR="desativado"
ASSINATURA_FAKE_LOCAL_ENABLED="false"
ASSINATURA_JOBS_ENABLED="false"

# O plano Pró permanece indisponível até a homologação financeira e operacional.
ASSINATURA_PRO_DISPONIVEL="false"

# Ambientes mutuamente exclusivos. Produção exige NODE_ENV=production, ASAAS_ENV=production,
# chave $aact_prod_, retornos HTTPS e webhook próprio. Segredos só no gerenciador da hospedagem.
ASSINATURA_ASAAS_PRODUCTION_ENABLED="false"
# ID da conta real conferido no Asaas; produção também exige ASSINATURA_JOBS_ENABLED=true.
ASAAS_ACCOUNT_ID=""
# Configuração abaixo é exclusivamente Sandbox.
ASSINATURA_ASAAS_SANDBOX_ENABLED="false"
ASAAS_ENV="sandbox"
ASAAS_API_KEY="$aact_hmlg_SUBSTITUA_FORA_DO_REPOSITORIO"
ASAAS_WEBHOOK_TOKEN="substitua-por-token-sandbox-com-32-ou-mais-caracteres"
ASAAS_USER_AGENT="ValenBarber/1.0 (Node.js; sandbox)"
ASAAS_CHECKOUT_EXPIRACAO_MINUTOS="30"
ASAAS_CHECKOUT_SUCCESS_URL="http://localhost:5173/configuracoes?checkout=sucesso"
ASAAS_CHECKOUT_CANCEL_URL="http://localhost:5173/configuracoes?checkout=cancelado"
ASAAS_CHECKOUT_EXPIRED_URL="http://localhost:5173/configuracoes?checkout=expirado"

# Assistente IA: somente backend. Consumo desligado por padrão.
IA_ENABLED=false
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VOICE_MODEL=
IA_MENSAGENS_BASICO=100
IA_MENSAGENS_PRO=200
# Decisões comerciais pendentes: vazio bloqueia, nunca equivale a ilimitado.
IA_CREDITOS_BASICO=
IA_CREDITOS_PRO=
IA_CUSTO_CREDITO_MICROUSD=
# Renovação segue o ciclo mensal confirmado da assinatura, sem acumular saldo.
# Regra de produto fixa no servidor; não há override IA_RENOVACAO.
# TODOS_CUSTOS ou APENAS_BACKEND; nenhuma opção escolhida por padrão.
IA_VOZ_CREDITOS=
# Habilitar somente após revisar/aplicar a migration no ambiente alvo.
IA_PERSISTENCIA_ENABLED=false
# Política de contagem ainda requer decisão explícita: RESPOSTA_CONCLUIDA.
IA_CONTAGEM_TEXTO=
IA_POLITICA_VERSAO=
# Tarifas conservadoras (entrada sem desconto de cache), em microunidades USD/milhão.
IA_TARIFA_ENTRADA_MICROUSD_MILHAO=
IA_TARIFA_SAIDA_MICROUSD_MILHAO=
IA_TARIFA_VERSAO=
# Chave de 32 bytes em base64; retenção de 1 a 720 horas, a definir.
IA_RESULTADO_CHAVE_BASE64=
IA_RESULTADO_RETENCAO_HORAS=

# Voz no servidor normal: manter desligada até configurar cotas/migration.
IA_VOZ_ENABLED=false
# URL pública do BACKEND, não do frontend; Railway aceita WebSocket por HTTP/1.1.
IA_VOZ_PUBLIC_URL=wss://api.example.invalid/ia/voz/conexao
# Origens exatas do frontend, separadas por vírgula, sem barra final ou curinga.
IA_VOZ_ORIGENS=https://app.example.invalid
# Segredo próprio de ao menos 32 caracteres, igual em todas as réplicas.
IA_VOZ_TICKET_SECRET=
# Defina OPENAI_VOICE_MODEL com o snapshot validado em limitesVoz.ts.
# A integração atual requer IA_VOZ_CREDITOS=TODOS_CUSTOS.

{
  "name": "barbearia-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test:ia": "node --import tsx scripts/testes_ia.ts && node --import tsx scripts/testes_periodo_ia.ts",
    "test:ia-postgres": "node --import tsx scripts/testes_ia_postgres.ts",
    "test:ia-analises": "node --import tsx scripts/testes_ia_analises.ts",
    "test:ia-contexto": "node --import tsx scripts/testes_ia_contexto.ts",
    "test:ia-ajuda": "node --import tsx scripts/testes_ia_ajuda.ts",
    "test:ia-comissoes": "node --import tsx scripts/testes_ia_comissoes.ts",
    "test:ia-voz": "node --import tsx scripts/testes_ia_voz.ts && node --import tsx scripts/testes_ia_voz_postgres.ts",
    "test:ia-voz-producao": "node --import tsx scripts/testes_ia_voz_producao.ts",
    "test:backup-tls": "node --import tsx scripts/testes_backup_tls.ts",
    "test:producao-barbeiro": "node --import tsx scripts/testes_producao_barbeiro.ts",
    "test:regularizacao": "node --import tsx scripts/testes_regularizacao_asaas.ts",
    "test:reversoes-postgres": "node --import tsx scripts/testes_reversoes_postgres_local.ts",
    "check:cobranca": "tsx scripts/verificar_prontidao_cobranca.ts",
    "test:extrato-pontos": "node --import tsx scripts/testes_extrato_pontos.ts",
    "test:protecao-venda": "node --import tsx scripts/testes_protecao_venda.ts",
    "test:rateio-desconto": "node --import tsx scripts/testes_rateio_desconto.ts",
    "test:estoque": "node --import tsx scripts/testes_estoque_venda.ts",
    "dev": "tsx watch src/server.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "seed:multitenant": "tsx prisma/seed-multitenant.ts",
    "seed:descontos": "tsx prisma/seed-testes-desconto.ts",
    "fix:admin": "tsx fix_admin_barbearia.ts",
    "backup:force": "tsx scripts/force_backup.ts",
    "test:fechamento": "node --import tsx scripts/testes_fechamento.ts",
    "test:fidelidade": "node --import tsx scripts/testes_fidelidade_combo.ts",
    "test:financeiro": "node --import tsx scripts/testes_financeiro_postgres.ts",
    "test:concorrencia": "node --import tsx scripts/testes_resgate_concorrente.ts",
    "test:comissao": "node --import tsx scripts/testes_relatorio_comissao.ts",
    "test:comissao-http": "node --import tsx scripts/testes_comissao_http.ts",
    "test:email-admin": "node --import tsx scripts/testes_email_admin.ts",
    "test:email-admin-postgres": "node --import tsx scripts/testes_email_admin_postgres.ts",
    "test:conta-seguranca-postgres-local": "node --import tsx scripts/testes_conta_seguranca_postgres_local.ts",
    "test:barbearia-inativa": "node --import tsx scripts/testes_barbearia_inativa.ts",
    "test:dashboard": "node --import tsx scripts/testes_dashboard_atendimentos.ts",
    "test:dashboard-postgres": "node --import tsx scripts/testes_dashboard_postgres.ts",
    "test:assinatura": "node --import tsx scripts/testes_cancelamento_assinatura.ts",
    "test:data-nascimento": "node --import tsx scripts/testes_data_nascimento.ts",
    "test:preferencias-promocionais": "node --import tsx scripts/testes_preferencias_promocionais.ts",
    "test:regras-assinatura": "node --import tsx scripts/testes_regras_assinatura.ts",
    "test:limites-assinatura": "node --import tsx scripts/testes_limites_acesso_assinatura.ts",
    "test:arquivamento-cliente": "node --import tsx scripts/testes_arquivamento_cliente.ts",
    "test:retencao-backup": "node --import tsx scripts/testes_retencao_backup.ts",
    "test:exportacao": "node --import tsx scripts/testes_exportacao.ts",
    "test:provedor-asaas": "node --import tsx scripts/testes_provedor_asaas.ts",
    "test:assinatura-fluxo-local": "node --import tsx scripts/testes_assinatura_fluxo_local.ts",
    "test": "npm run test:fechamento && npm run test:fidelidade && npm run test:comissao && npm run test:email-admin && npm run test:dashboard && npm run test:assinatura && npm run test:regras-assinatura && npm run test:limites-assinatura && npm run test:arquivamento-cliente && npm run test:retencao-backup && npm run test:exportacao && npm run test:data-nascimento && npm run test:preferencias-promocionais && npm run test:provedor-asaas && npm run test:assinatura-fluxo-local && npm run test:cadastro-seguro && npm run test:codigos-conta && npm run test:seguranca",
    "test:cadastro-seguro": "node --import tsx scripts/testes_cadastro_seguro.ts",
    "test:codigos-conta": "node --import tsx scripts/testes_codigos_conta.ts && node --import tsx scripts/testes_rotas_codigos.ts",
    "test:logs-seguros": "node --import tsx scripts/testes_logs_seguros.ts",
    "test:dependencia-config": "node scripts/testes_dependencia_config.mjs",
    "test:limites-tenant-agenda": "node --import tsx scripts/testes_limites_tenant_agenda.ts",
    "test:sessoes-limites": "node --import tsx scripts/testes_sessoes_limites.ts",
    "test:upload-seguro": "node --import tsx scripts/testes_upload_seguro.ts",
    "test:autorizacao-postgres-local": "node --import tsx scripts/testes_autorizacao_postgres_local.ts",
    "test:sessao-postgres-local": "node --import tsx scripts/testes_sessao_postgres_local.ts",
    "test:upload-postgres-local": "node --import tsx scripts/testes_upload_postgres_local.ts",
    "test:seguranca": "npm run test:limites-tenant-agenda && npm run test:sessoes-limites && npm run test:upload-seguro && npm run test:logs-seguros && npm run test:dependencia-config"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "^2.107.0",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.5.0",
    "pg": "^8.22.0",
    "resend": "^6.14.0",
    "sharp": "0.35.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

// ============================================
// Schema do banco de dados — Garoa Barbearia
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums ---

enum Papel {
  ADMIN
  BARBEIRO
  CLIENTE
}

enum StatusAgendamento {
  AGUARDANDO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
}

enum TipoRecompensa {
  SERVICO_GRATIS
  DESCONTO_PERCENTUAL
  DESCONTO_REAIS
}

enum RemetenteMensagem {
  CLIENTE
  ADMIN
}

enum TipoDesconto {
  NENHUM
  REAIS
  PERCENTUAL
  PONTOS
  COMBINADO
}

enum TipoTransacaoPontos {
  ACUMULO
  RESGATE
  AJUSTE_MANUAL
  ESTORNO
}

// --- Modelos ---

enum StatusAprovacao {
  PENDENTE
  APROVADO
  REJEITADO
}

enum StatusResgate {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

enum StatusCancelamentoAssinatura {
  PROCESSAMENTO_PENDENTE
  RENOVACAO_CANCELADA
  REJEITADA
}

enum CanalCancelamentoAssinatura {
  SISTEMA
  EMAIL
}

enum PlanoAssinatura {
  BASICO
  PRO
}

enum PeriodicidadeAssinatura {
  MENSAL
  ANUAL
}

enum StatusAssinatura {
  PRE_CADASTRO
  TESTE
  ATIVA
  PAGAMENTO_PENDENTE
  CONSULTA_EXPORTACAO
  ENCERRADA
}

enum TipoMudancaAssinatura {
  UPGRADE
  DOWNGRADE
  PERIODICIDADE
}

enum StatusMudancaAssinatura {
  SOLICITADA
  AGUARDANDO_PAGAMENTO
  AGENDADA
  EFETIVADA
  CANCELADA
}

enum OrigemPreferenciaPromocional {
  VALEN
  BARBEARIA
}

enum StatusExclusaoDados {
  AGUARDANDO_POLITICA
  RETENCAO_LEGAL
  EXCLUSAO_AUTORIZADA
  PROPAGADA_BACKUP
}

enum StatusEventoWebhookAsaas {
  PENDENTE
  PROCESSANDO
  PROCESSADO
  IGNORADO
  FALHA
}

model Barbearia {
  legadoAssinatura Boolean @default(false)
  avisoMigracaoEm DateTime?
  prazoMigracaoAte DateTime?
  consultaMigracaoAte DateTime?
  id                  String   @id @default(uuid())
  nome                String
  slug                String   @unique
  telefone            String?
  endereco            String?
  logo                String?
  corPrimaria         String?  @default("#FF8C00") // Laranja
  corSecundaria       String?  @default("#1A1A1A") // Escuro
  corTexto            String?  @default("#FFFFFF") // Branco
  fonte               String?  @default("Inter")
  fonteCorpo          String?  @default("Inter")
  fonteNumeros        String?  @default("DM Mono")
  horarioAbertura     String?  @default("09:00")
  horarioFechamento   String?  @default("19:00")
  temAlmoco           Boolean  @default(false)
  horarioAlmocoInicio String?  @default("12:00")
  horarioAlmocoFim    String?  @default("13:00")
  diasFuncionamento   String[] @default(["1", "2", "3", "4", "5", "6"]) // Seg a Sab
  ativo               Boolean  @default(true)
  createdAt           DateTime @default(now())

  usuarios                           Usuario[]
  barbeiros                          Barbeiro[]
  clientes                           Cliente[]
  servicos                           Servico[]
  agendamentos                       Agendamento[]
  lancamentosFinanceiros             LancamentoFinanceiro[]
  itens                              ItemAtendimento[]
  estoque                            Estoque[]
  vendasProdutos                     VendaProduto[]
  vendasEstoque                      VendaEstoque[]
  configuracoes                      Configuracao[]
  historicoRemarcacoes               HistoricoRemarcacao[]
  clientesBarbearias                 ClienteBarbearia[]
  pontosFidelidade                   PontoFidelidade[]
  configuracaoFidelidade             ConfiguracaoFidelidade?
  recompensas                        Recompensa[]
  resgatesRecompensa                 ResgateRecompensa[]
  chatMensagens                      ChatMensagem[]
  indicacoes                         Indicacao[]
  avaliacoes                         Avaliacao[]
  solicitacoesCancelamentoAssinatura SolicitacaoCancelamentoAssinatura[]
  assinaturaSaas                     AssinaturaSaas?
  preferenciasPromocionais           PreferenciaPromocional[]

  @@map("barbearias")
}

model Usuario {
  id                String    @id @default(uuid())
  nome              String
  email             String
  senha             String
  papel             Papel     @default(CLIENTE)
  barbeariaId       String?
  emailVerificado   Boolean   @default(false)
  // Nulos preservam ausência de aceite (legado ou cadastro por administrador).
  aceiteDocumentosEm DateTime?
  termosUsoVersao String?
  privacidadeVersao String?
  aceiteDocumentosOrigem String?
  codigoVerificacao String?
  codigoExpiracao   DateTime?
  createdAt         DateTime  @default(now())

  barbearia                          Barbearia?                          @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeiro                           Barbeiro?
  cliente                            Cliente?
  remarcacoesFeitas                  HistoricoRemarcacao[]
  solicitacoesCancelamentoAssinatura SolicitacaoCancelamentoAssinatura[]
  aceitesAssinatura                  AssinaturaSaas[]                    @relation("AceiteAssinaturaUsuario")
  mudancasAssinaturaSolicitadas      MudancaAssinatura[]                 @relation("SolicitanteMudancaAssinatura")

  @@unique([email, barbeariaId])
  @@map("usuarios")
}

model Barbeiro {
  id               String   @id @default(uuid())
  usuarioId        String   @unique
  barbeariaId      String?
  foto             String?
  especialidades   String[]
  comissaoPercent  Float    @default(50)
  cor              String?  @default("#F97316") // Laranja
  ativo            Boolean  @default(true)
  trabalhandoAgora Boolean  @default(false)
  telefone         String?
  horariosTrabalho Json?
  avaliacaoMedia   Float?   @default(5.0)

  barbearia             Barbearia?             @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  usuario               Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  agendamentos          Agendamento[]
  lancamentos           LancamentoFinanceiro[]
  aprovacoes            AprovacaoEdicao[]
  bloqueiosAgenda       BloqueioAgenda[]
  avaliacoes            Avaliacao[]
  remarcacoesAnteriores HistoricoRemarcacao[]  @relation("BarbeiroAnteriorRel")
  remarcacoesNovas      HistoricoRemarcacao[]  @relation("BarbeiroNovoRel")

  @@index([barbeariaId])
  @@map("barbeiros")
}

model BloqueioAgenda {
  id         String   @id @default(uuid())
  barbeiroId String
  dataInicio DateTime
  dataFim    DateTime
  motivo     String?
  createdAt  DateTime @default(now())

  barbeiro Barbeiro @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)

  @@index([barbeiroId])
  @@index([dataInicio, dataFim])
  @@map("bloqueios_agenda")
}

model Cliente {
  id              String    @id @default(uuid())
  usuarioId       String    @unique
  barbeariaId     String?
  telefone        String?
  dataNascimento  DateTime?
  observacoes     String?
  codigoIndicacao String?   @unique

  barbearia                Barbearia?               @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  usuario                  Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  agendamentos             Agendamento[]
  clientesBarbearias       ClienteBarbearia[]
  pontosFidelidade         PontoFidelidade[]
  resgatesRecompensa       ResgateRecompensa[]
  lancamentos              LancamentoFinanceiro[]
  chatMensagens            ChatMensagem[]
  indicacoesFeitas         Indicacao[]              @relation("Indicador")
  indicacaoRecebida        Indicacao[]              @relation("Indicado")
  avaliacoes               Avaliacao[]
  preferenciasPromocionais PreferenciaPromocional[]

  @@index([barbeariaId])
  @@map("clientes")
}

model ClienteBarbearia {
  id          String    @id @default(uuid())
  clienteId   String
  barbeariaId String?
  ativo       Boolean   @default(true)
  arquivadoEm DateTime?
  conectadoEm DateTime  @default(now())

  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  barbearia Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@unique([clienteId, barbeariaId])
  @@map("clientes_barbearias")
}

model PreferenciaPromocional {
  id              String                       @id @default(uuid())
  clienteId       String
  origem          OrigemPreferenciaPromocional
  chaveOrigem     String
  barbeariaId     String?
  emailHabilitado Boolean                      @default(false)
  emailAlteradoEm DateTime?
  inAppHabilitado Boolean                      @default(false)
  inAppAlteradoEm DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  barbearia Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@unique([clienteId, chaveOrigem])
  @@index([barbeariaId])
  @@map("preferencias_promocionais")
}

model ExclusaoDadosAuditavel {
  id                  String              @id @default(uuid())
  entidade            String
  registroId          String
  barbeariaId         String?
  status              StatusExclusaoDados @default(AGUARDANDO_POLITICA)
  solicitadoEm        DateTime            @default(now())
  excluidoPrincipalEm DateTime?
  removerBackupAte    DateTime?
  retencaoLegal       Boolean             @default(false)
  motivoRetencao      String?
  propagadoBackupEm   DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([entidade, registroId])
  @@index([status, removerBackupAte])
  @@index([barbeariaId])
  @@map("exclusoes_dados_auditaveis")
}

enum BaseCalculoComissao {
  VALOR_BRUTO
  VALOR_LIQUIDO
}

enum BaseCalculoPontos {
  VALOR_BRUTO
  VALOR_LIQUIDO
}

model PontoFidelidade {
  id            String              @id @default(uuid())
  clienteId     String
  barbeariaId   String?
  agendamentoId String?             @unique
  lancamentoId  String?             @unique
  tipo          TipoTransacaoPontos @default(ACUMULO)
  pontos        Int
  saldoApos     Int                 @default(0)
  descricao     String
  data          DateTime            @default(now())

  cliente    Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  barbearia  Barbearia?            @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  lancamento LancamentoFinanceiro? @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  @@map("pontos_fidelidade")
}

model Servico {
  id              String  @id @default(uuid())
  barbeariaId     String?
  nome            String
  descricao       String?
  preco           Decimal @db.Decimal(10, 2)
  duracaoMinutos  Int
  comissaoPercent Float   @default(50)
  cor             String? @default("#22C55E") // Verde
  ativo           Boolean @default(true)

  barbearia             Barbearia?             @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamentos          Agendamento[]
  lancamentos           LancamentoFinanceiro[]
  itens                 ItemAtendimento[]
  recompensas           Recompensa[]
  remarcacoesAnteriores HistoricoRemarcacao[]  @relation("ServicoAnteriorRel")
  remarcacoesNovas      HistoricoRemarcacao[]  @relation("ServicoNovoRel")

  @@map("servicos")
}

model Agendamento {
  id           String            @id @default(uuid())
  barbeariaId  String?
  clienteId    String
  barbeiroId   String
  servicoId    String
  servicosIds  String[]          @default([])
  dataHora     DateTime
  status       StatusAgendamento @default(AGUARDANDO)
  observacoes  String?
  valorCobrado Decimal           @db.Decimal(10, 2)
  origem       String            @default("SISTEMA")

  // Descontos e Fidelidade
  valorBruto              Decimal      @default(0) @db.Decimal(10, 2)
  tipoDesconto            TipoDesconto @default(NENHUM)
  descontoManual          Decimal      @default(0) @db.Decimal(10, 2)
  descontoPercentualAplic Decimal?     @db.Decimal(10, 2)
  pontosUtilizados        Int          @default(0)
  descontoPontos          Decimal      @default(0) @db.Decimal(10, 2)
  valorDesconto           Decimal      @default(0) @db.Decimal(10, 2)
  valorLiquido            Decimal      @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  barbearia Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  barbeiro  Barbeiro   @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  servico   Servico    @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  lancamentos          LancamentoFinanceiro[]
  itens                ItemAtendimento[]
  avaliacao            Avaliacao?
  historicoRemarcacoes HistoricoRemarcacao[]

  @@index([barbeariaId, dataHora])
  @@index([clienteId])
  @@index([barbeiroId])
  @@map("agendamentos")
}

model LancamentoFinanceiro {
  id             String         @id @default(uuid())
  barbeariaId    String?
  tipo           TipoLancamento
  categoria      String
  descricao      String?
  valor          Decimal        @db.Decimal(10, 2)
  formaPagamento FormaPagamento
  agendamentoId  String?

  clienteId            String?
  barbeiroId           String?
  servicoId            String?
  valorComissao        Decimal?             @db.Decimal(10, 2)
  valorLiquido         Decimal?             @db.Decimal(10, 2)
  percentualComissao   Decimal?             @db.Decimal(10, 2)
  baseComissaoAplicada BaseCalculoComissao?

  data      DateTime
  createdAt DateTime @default(now())

  aprovacoes AprovacaoEdicao[]

  barbearia           Barbearia?        @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamento         Agendamento?      @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  cliente             Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  barbeiro            Barbeiro?         @relation(fields: [barbeiroId], references: [id], onDelete: SetNull)
  servico             Servico?          @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  pontoFidelidade     PontoFidelidade?
  vendaEstoque        VendaEstoque?     @relation("VendaOriginal")
  estornoVendaEstoque VendaEstoque?     @relation("VendaEstorno")
  itens               ItemAtendimento[]

  @@index([barbeariaId, data])
  @@map("lancamentos_financeiros")
}

model Estoque {
  id               String   @id @default(uuid())
  barbeariaId      String?
  nome             String
  categoria        String?
  quantidade       Int
  unidade          String
  quantidadeMinima Int      @default(5)
  custo            Decimal  @db.Decimal(10, 2)
  precoVenda       Decimal? @db.Decimal(10, 2)

  barbearia Barbearia?     @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  vendas    VendaProduto[]

  @@index([barbeariaId])
  @@map("estoque")
}

model VendaProduto {
  id              String         @id @default(uuid())
  barbeariaId     String?
  estoqueId       String?
  vendaId         String?
  nomeProduto     String
  quantidade      Int
  precoVenda      Decimal        @db.Decimal(10, 2)
  custoUnitario   Decimal        @db.Decimal(10, 2)
  lucro           Decimal        @db.Decimal(10, 2)
  descontoRateado Decimal?       @db.Decimal(10, 2)
  formaPagamento  FormaPagamento
  data            DateTime       @default(now())

  barbearia Barbearia?    @relation(fields: [barbeariaId], references: [id], onDelete: SetNull)
  estoque   Estoque?      @relation(fields: [estoqueId], references: [id], onDelete: SetNull)
  venda     VendaEstoque? @relation(fields: [vendaId], references: [id], onDelete: Restrict)

  @@index([vendaId])
  @@index([barbeariaId, data])
  @@map("vendas_produtos")
}

model VendaEstoque {
  id                  String                @id @default(uuid())
  barbeariaId         String
  chaveRequisicao     String
  total               Decimal               @db.Decimal(10, 2)
  valorBruto          Decimal?              @db.Decimal(10, 2)
  tipoDesconto        TipoDesconto?
  valorDesconto       Decimal?              @db.Decimal(10, 2)
  descontoManual      Decimal?              @db.Decimal(10, 2)
  descontoPontos      Decimal?              @db.Decimal(10, 2)
  descontoPercentual  Decimal?              @db.Decimal(10, 2)
  pontosUtilizados    Int?
  formaPagamento      FormaPagamento
  data                DateTime              @default(now())
  lancamentoId        String                @unique
  estornadaEm         DateTime?
  motivoEstorno       String?
  estornadoPorId      String?
  estornoLancamentoId String?               @unique
  barbearia           Barbearia             @relation(fields: [barbeariaId], references: [id], onDelete: Restrict)
  lancamento          LancamentoFinanceiro  @relation("VendaOriginal", fields: [lancamentoId], references: [id], onDelete: Restrict)
  estornoLancamento   LancamentoFinanceiro? @relation("VendaEstorno", fields: [estornoLancamentoId], references: [id], onDelete: Restrict)
  itens               VendaProduto[]

  @@unique([barbeariaId, chaveRequisicao])
  @@index([barbeariaId, data])
  @@map("vendas_estoque")
}

model Configuracao {
  id                    String  @id @default(uuid())
  barbeariaId           String? @unique
  horariosFuncionamento Json?
  regrasFidelidade      Json?

  baseCalculoComissao BaseCalculoComissao @default(VALOR_LIQUIDO)
  baseCalculoPontos   BaseCalculoPontos   @default(VALOR_LIQUIDO)

  barbearia Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@map("configuracoes")
}

model AssinaturaSaas {
  id                      String                  @id @default(uuid())
  barbeariaId             String                  @unique
  plano                   PlanoAssinatura
  periodicidade           PeriodicidadeAssinatura
  status                  StatusAssinatura        @default(PRE_CADASTRO)
  precoCicloCentavos      Int
  cicloInicio             DateTime?
  cicloFim                DateTime?
  testeInicio             DateTime?
  testeFim                DateTime?
  proximaCobrancaEm       DateTime?
  renovacaoAutomatica     Boolean                 @default(true)
  provedor                String                  @default("ASAAS")
  clienteExternoId        String?
  assinaturaExternaId     String?                 @unique
  checkoutExternoId       String?                 @unique
  checkoutUrl             String?
  checkoutExpiraEm        DateTime?
  formasPagamento         String[]                @default([])
  contratacaoIdempotencia String?                 @unique
  ultimoEventoProvedorEm  DateTime?
  ultimaCobrancaExternaId String?
  ofertaVersao            String?
  termosVersao            String?
  aceiteEm                DateTime?
  aceitePorId             String?
  avisoLimiteClientesEm   DateTime?
  avisoPagamentoEm        DateTime?
  toleranciaAte           DateTime?
  fimAcessoEm             DateTime?
  consultaExportacaoAte   DateTime?
  reajusteAvisadoEm       DateTime?
  reajusteEfetivoEm       DateTime?
  reajustePrecoCentavos   Int?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  barbearia     Barbearia                           @relation(fields: [barbeariaId], references: [id], onDelete: Restrict)
  aceitePor     Usuario?                            @relation("AceiteAssinaturaUsuario", fields: [aceitePorId], references: [id], onDelete: Restrict)
  mudancas      MudancaAssinatura[]
  cancelamentos SolicitacaoCancelamentoAssinatura[]

  @@index([status, proximaCobrancaEm])
  @@map("assinaturas_saas")
}

model MudancaAssinatura {
  id                     String                  @id @default(uuid())
  assinaturaId           String
  solicitadoPorId        String
  tipo                   TipoMudancaAssinatura
  status                 StatusMudancaAssinatura @default(SOLICITADA)
  planoOrigem            PlanoAssinatura
  planoDestino           PlanoAssinatura
  periodicidadeOrigem    PeriodicidadeAssinatura
  periodicidadeDestino   PeriodicidadeAssinatura
  valorAdicionalCentavos Int                     @default(0)
  efetivarEm             DateTime?
  chaveIdempotencia      String                  @unique
  checkoutExternoId      String?                 @unique
  checkoutUrl            String?
  checkoutExpiraEm       DateTime?
  ofertaVersao           String
  aceiteEm               DateTime
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  assinatura    AssinaturaSaas @relation(fields: [assinaturaId], references: [id], onDelete: Restrict)
  solicitadoPor Usuario        @relation("SolicitanteMudancaAssinatura", fields: [solicitadoPorId], references: [id], onDelete: Restrict)

  @@index([assinaturaId, status])
  @@map("mudancas_assinatura")
}

model EventoWebhookAsaas {
  id                String                   @id @default(uuid())
  eventoExternoId   String                   @unique
  tipo              String
  recursoTipo       String?
  recursoExternoId  String?
  referenciaExterna String?
  resumo            Json
  status            StatusEventoWebhookAsaas @default(PENDENTE)
  tentativas        Int                      @default(0)
  recebidoEm        DateTime                 @default(now())
  ocorridoEm        DateTime?
  processadoEm      DateTime?
  ultimoErro        String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([status, recebidoEm])
  @@index([referenciaExterna])
  @@index([recursoExternoId])
  @@map("eventos_webhook_asaas")
}

model SolicitacaoCancelamentoAssinatura {
  id                       String                       @id @default(uuid())
  barbeariaId              String
  solicitadoPorId          String
  solicitadoPorEmail       String
  canal                    CanalCancelamentoAssinatura  @default(SISTEMA)
  status                   StatusCancelamentoAssinatura @default(PROCESSAMENTO_PENDENTE)
  chaveIdempotencia        String                       @unique
  aberta                   Boolean?                     @default(true)
  recebidoEm               DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  provedor                 String                       @default("ASAAS")
  assinaturaExternaId      String?
  assinaturaId             String?
  tentativasProvedor       Int                          @default(0)
  ultimaTentativaEm        DateTime?
  ultimoErroProvedor       String?
  cancelamentoConfirmadoEm DateTime?
  fimAcessoEm              DateTime?
  motivo                   String?

  barbearia     Barbearia       @relation(fields: [barbeariaId], references: [id], onDelete: Restrict)
  solicitadoPor Usuario         @relation(fields: [solicitadoPorId], references: [id], onDelete: Restrict)
  assinatura    AssinaturaSaas? @relation(fields: [assinaturaId], references: [id], onDelete: Restrict)

  // Em PostgreSQL, valores NULL não colidem. Assim há uma solicitação aberta por
  // barbearia e o histórico encerrado pode ser preservado com aberta = NULL.
  @@unique([barbeariaId, aberta])
  @@index([barbeariaId, status])
  @@map("solicitacoes_cancelamento_assinatura")
}

model ConfiguracaoFidelidade {
  id                     String  @id @default(uuid())
  barbeariaId            String? @unique
  ativo                  Boolean @default(false)
  pontosPorReal          Int     @default(0)
  pontosPorVisita        Int     @default(0)
  pontosDobroAniversario Boolean @default(false)
  pontosPorIndicacao     Int     @default(0)
  pontosParaIndicado     Int     @default(0)
  pontosBoasVindas       Int     @default(0)
  valorPorPonto          Decimal @default(0.00) @db.Decimal(10, 2)
  regrasPorServico       Json?

  // Resgate de pontos como desconto
  resgatePontosAtivo        Boolean @default(false)
  percentualMaxPontos       Int     @default(30)
  descontoMaxReais          Decimal @default(0) @db.Decimal(10, 2)
  descontoMaxPercentual     Decimal @default(100) @db.Decimal(10, 2)
  permitirCombinarDescontos Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barbearia Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_fidelidade")
}

model Recompensa {
  id                String         @id @default(uuid())
  barbeariaId       String?
  nome              String
  tipo              TipoRecompensa
  valorDesconto     Decimal?       @db.Decimal(10, 2)
  servicoId         String?
  pontosNecessarios Int
  ativo             Boolean        @default(true)
  createdAt         DateTime       @default(now())

  barbearia Barbearia?          @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  servico   Servico?            @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  resgates  ResgateRecompensa[]

  @@map("recompensas")
}

model ResgateRecompensa {
  id            String        @id @default(uuid())
  clienteId     String
  recompensaId  String
  barbeariaId   String?
  pontosUsados  Int
  status        StatusResgate @default(PENDENTE)
  confirmadoPor String?
  confirmadoEm  DateTime?
  createdAt     DateTime      @default(now())

  cliente    Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  recompensa Recompensa @relation(fields: [recompensaId], references: [id], onDelete: Cascade)
  barbearia  Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@map("resgates_recompensa")
}

model ChatMensagem {
  id          String            @id @default(uuid())
  barbeariaId String?
  clienteId   String
  texto       String
  remetente   RemetenteMensagem
  lida        Boolean           @default(false)
  createdAt   DateTime          @default(now())

  barbearia Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("chat_mensagens")
}

model Indicacao {
  id              String   @id @default(uuid())
  barbeariaId     String?
  indicadorId     String
  indicadoId      String
  pontosAwardados Boolean  @default(false)
  createdAt       DateTime @default(now())

  barbearia Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  indicador Cliente    @relation("Indicador", fields: [indicadorId], references: [id], onDelete: Cascade)
  indicado  Cliente    @relation("Indicado", fields: [indicadoId], references: [id], onDelete: Cascade)

  @@map("indicacoes")
}

model AprovacaoEdicao {
  id           String          @id @default(uuid())
  lancamentoId String
  barbeiroId   String
  acao         String // "EDITAR" ou "EXCLUIR"
  dadosNovos   Json? // Null if acao == EXCLUIR
  status       StatusAprovacao @default(PENDENTE)
  createdAt    DateTime        @default(now())

  lancamento LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  barbeiro   Barbeiro             @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)

  @@map("aprovacoes_edicao")
}

model BoasVindasConcedida {
  id          String   @id @default(uuid())
  clienteId   String
  barbeariaId String
  createdAt   DateTime @default(now())

  @@unique([clienteId, barbeariaId])
  @@map("boas_vindas_concedidas")
}

model Avaliacao {
  id            String   @id @default(uuid())
  barbeariaId   String?
  barbeiroId    String
  clienteId     String
  agendamentoId String   @unique
  nota          Int
  comentario    String?
  data          DateTime @default(now())

  barbearia   Barbearia?  @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeiro    Barbeiro    @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  cliente     Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([barbeiroId])
  @@map("avaliacoes")
}

model HistoricoRemarcacao {
  id                 String   @id @default(uuid())
  agendamentoId      String
  barbeariaId        String?
  dataHoraAnterior   DateTime
  dataHoraNova       DateTime
  barbeiroAnteriorId String?
  barbeiroNovoId     String?
  servicoAnteriorId  String?
  servicoNovoId      String?
  usuarioAcaoId      String?
  criadoEm           DateTime @default(now())

  agendamento      Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  barbearia        Barbearia?  @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  barbeiroAnterior Barbeiro?   @relation("BarbeiroAnteriorRel", fields: [barbeiroAnteriorId], references: [id], onDelete: SetNull)
  barbeiroNovo     Barbeiro?   @relation("BarbeiroNovoRel", fields: [barbeiroNovoId], references: [id], onDelete: SetNull)
  servicoAnterior  Servico?    @relation("ServicoAnteriorRel", fields: [servicoAnteriorId], references: [id], onDelete: SetNull)
  servicoNovo      Servico?    @relation("ServicoNovoRel", fields: [servicoNovoId], references: [id], onDelete: SetNull)
  usuarioAcao      Usuario?    @relation(fields: [usuarioAcaoId], references: [id], onDelete: SetNull)

  @@index([agendamentoId])
  @@map("historico_remarcacoes")
}

model ItemAtendimento {
  // Nota Arquitetural: Não usamos CHECK constraint no PostgreSQL para garantir
  // a exclusão mútua de (agendamentoId vs lancamentoId) pois o Prisma não modela CHECK nativamente,
  // o que causaria conflitos e falhas no comando `db push` rodado no boot em produção.
  // A garantia de vínculo único é feita pela inserção aninhada e transacionada no código.
  id          String  @id @default(uuid())
  barbeariaId String?

  agendamentoId String?
  lancamentoId  String?

  servicoId      String?
  nome           String
  preco          Decimal @db.Decimal(10, 2)
  duracaoMinutos Int
  ordem          Int     @default(0)

  agendamento Agendamento?          @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  lancamento  LancamentoFinanceiro? @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  servico     Servico?              @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  barbearia   Barbearia?            @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  @@index([barbeariaId])
  @@index([agendamentoId])
  @@index([lancamentoId])
  @@index([servicoId])
  @@map("itens_atendimento")
}

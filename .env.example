# ============================================
# VARIÁVEIS DE AMBIENTE — GAROA BARBEARIA
# ============================================
# Copie este arquivo para .env e preencha os valores

# Banco de dados — cole a connection string do Supabase aqui
DATABASE_URL="postgresql://postgres:[SENHA]@db.[PROJETO].supabase.co:5432/postgres"

# JWT — gere strings aleatórias longas e secretas (mínimo 24 caracteres)
JWT_SECRET="sua-chave-secreta-aqui"
JWT_SECRET_CLIENTE="sua-chave-secreta-cliente-aqui"
JWT_SECRET_BARBEIRO="sua-chave-secreta-barbeiro-aqui"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=production

# URL do frontend (para CORS) — cole a URL da Vercel depois do deploy
FRONTEND_URL="https://seu-app.vercel.app"

# Nome da barbearia (aparece na interface)
BARBEARIA_NOME="Barbearia do João"

# Assistente IA: somente backend. Nesta fase todas as rotas de consumo ficam bloqueadas.
IA_ENABLED=false
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VOICE_MODEL=
IA_MENSAGENS_BASICO=100
IA_MENSAGENS_PRO=200
# Decisões comerciais pendentes: vazio bloqueia, nunca equivale a ilimitado.
IA_CREDITOS_BASICO=
IA_CREDITOS_PRO=
IA_CUSTO_CREDITO_MICROUSD=
# MES_CALENDARIO ou ANIVERSARIO_ASSINATURA (America/Sao_Paulo)
IA_RENOVACAO=
# TODOS_CUSTOS ou APENAS_BACKEND; nenhuma opção escolhida por padrão.
IA_VOZ_CREDITOS=

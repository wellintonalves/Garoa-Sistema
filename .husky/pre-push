#!/bin/sh

echo "==> [pre-push] Validando build do BACKEND..."
cd backend || exit 1
npx prisma generate || { echo "X [pre-push] BLOQUEADO: prisma generate falhou"; exit 1; }
npx tsc --noEmit || { echo "X [pre-push] BLOQUEADO: erro de tipagem no backend"; exit 1; }
cd ..

echo "==> [pre-push] Validando build do FRONTEND..."
cd frontend || exit 1
npm run lint:cores || { echo "X [pre-push] BLOQUEADO: lint:cores falhou (cor hardcoded fora do Design System)"; exit 1; }
npx tsc -b || { echo "X [pre-push] BLOQUEADO: erro de tipagem no frontend"; exit 1; }
npx vite build || { echo "X [pre-push] BLOQUEADO: vite build falhou"; exit 1; }
cd ..

echo "OK [pre-push] Todos os builds passaram. Push liberado."
